METADATA_ENVIRONMENT=development
METADATA_MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=metadata-rs
METADATA_MONGO_DATABASE=semantic_metadata_v1
METADATA_MONGO_TIMEOUT_MS=5000
METADATA_MONGO_POOL_SIZE=50
METADATA_MAX_REQUEST_BYTES=1048576
METADATA_MAX_OBJECTS_PER_REVISION=5000
METADATA_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5174"]
METADATA_CLICKHOUSE_HOST=127.0.0.1
METADATA_CLICKHOUSE_PORT=8123
METADATA_CLICKHOUSE_USERNAME=default
METADATA_CLICKHOUSE_PASSWORD=semantic
METADATA_CLICKHOUSE_DATABASE=semantic
METADATA_CLICKHOUSE_SECURE=false
METADATA_CLICKHOUSE_TIMEOUT_SEC=30
METADATA_CSV_MAX_ROWS=5000
METADATA_CSV_MAX_FILE_BYTES=10485760
# Required when METADATA_ENVIRONMENT=production:
# METADATA_API_KEY=replace-with-a-secret-from-your-deployment

# Measure dependency graph and compiled SQL limits
METADATA_MEASURE_MAX_NODES=1024
METADATA_MEASURE_MAX_SQL_BYTES=4194304

# Planning View and engine read/build resource bounds.
METADATA_PLANNING_VIEW_MAX_GROUPS=5000
METADATA_PLANNING_VIEW_MAX_CELLS=50000
METADATA_CLICKHOUSE_MAX_THREADS=4
