    {
      "_id": "rev_1:measure_fqty",
      "modelId": "model_supply_planning",
      "revisionId": "rev_1",
      "objectId": "measure_fqty",
      "kind": "measure",
      "schemaVersion": 1,
      "name": "FQTY",
      "displayName": "Forecast Quantity",
      "description": "Forecast quantity at product-location-day; summed across location when read at PT.",
      "business": {
        "unit": "EA"
      },
      "definition": {
        "measureType": "referenced",
        "transactionId": "tx_forecast",
        "valueColumnId": "forecast_qty",
        "nativePlanningLevelId": "pl_plt",
        "resultType": {
          "type": "number",
          "nullable": true
        },
        "aggregation": {
          "nonTime": "sum",
          "time": "sum",
          "nullInputPolicy": "ignore",
          "allNullResult": "null"
        },
        "missingTransactionValue": "null",
        "sourceNullPolicy": "reject",
        "overflowPolicy": "error",
        "allocation": {
          "mode": "none"
        },
        "editable": false
      }
    },
    {
      "_id": "rev_1:measure_sqty",
