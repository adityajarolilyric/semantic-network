    {
      "_id": "rev_1:measure_error",
      "modelId": "model_supply_planning",
      "revisionId": "rev_1",
      "objectId": "measure_error",
      "kind": "measure",
      "schemaVersion": 1,
      "name": "Error",
      "displayName": "Absolute Forecast Error",
      "description": "Absolute difference between aggregated forecast and aggregated sales at the requested PT or coarser output grain.",
      "business": {
        "unit": "EA"
      },
      "definition": {
        "measureType": "calculated",
        "nativePlanningLevelId": "pl_pt",
        "calculationType": "AggregateFirst",
        "formula": {
          "displayText": "ABS(FQTY - SQTY)",
          "expression": {
            "type": "call",
            "function": "abs",
            "arguments": [
              {
                "type": "binary",
                "operator": "subtract",
                "left": {
                  "type": "measureRef",
                  "measureId": "measure_fqty"
                },
                "right": {
                  "type": "measureRef",
                  "measureId": "measure_sqty"
                }
              }
            ]
          }
        },
        "resultType": {
          "type": "decimal",
          "precision": 38,
          "scale": 3,
          "nullable": true
        },
        "nullInputPolicy": "propagate",
        "overflowPolicy": "error",
        "editable": false
      }
    }
