    {
      "_id": "rev_1:pl_plt",
      "modelId": "model_supply_planning",
      "revisionId": "rev_1",
      "objectId": "pl_plt",
      "kind": "planningLevel",
      "schemaVersion": 1,
      "name": "PLT",
      "displayName": "Product / Location / Time",
      "description": "Valid sourcing product-location pairs crossed with planning calendar days.",
      "definition": {
        "population": {
          "operation": "cartesian_product",
          "factors": [
            {
              "factorId": "sourcing",
              "sourceId": "src_sourcing",
              "selectedColumnIds": [
                "product_id",
                "location_id"
              ]
            },
            {
              "factorId": "calendar",
              "sourceId": "src_time",
              "selectedColumnIds": [
                "date"
              ]
            }
          ]
        },
        "grain": {
          "keyIds": [
            "plt_product",
            "plt_location",
            "plt_date"
          ],
          "columns": [
            {
              "grainColumnId": "plt_product",
              "name": "product_id",
              "populationRef": {
                "factorId": "sourcing",
                "columnId": "product_id"
              }
            },
            {
              "grainColumnId": "plt_location",
              "name": "location_id",
              "populationRef": {
                "factorId": "sourcing",
                "columnId": "location_id"
              }
            },
            {
              "grainColumnId": "plt_date",
              "name": "date",
              "populationRef": {
                "factorId": "calendar",
                "columnId": "date"
              }
            }
          ]
        },
        "dimensionBindings": [
          {
            "dimensionId": "dim_product",
            "keyMappings": [
              {
                "grainColumnId": "plt_product",
                "dimensionColumnId": "product_id"
              }
            ],
            "selectedAttributeColumnIds": [],
            "unmatchedMemberPolicy": "reject"
          },
          {
            "dimensionId": "dim_location",
            "keyMappings": [
              {
                "grainColumnId": "plt_location",
                "dimensionColumnId": "location_id"
              }
            ],
            "selectedAttributeColumnIds": [],
            "unmatchedMemberPolicy": "reject"
          },
          {
            "dimensionId": "dim_time",
            "keyMappings": [
              {
                "grainColumnId": "plt_date",
                "dimensionColumnId": "date"
              }
            ],
            "selectedAttributeColumnIds": [],
            "unmatchedMemberPolicy": "reject"
          }
        ],
        "filters": null,
