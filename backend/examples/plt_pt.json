      "revisionId": "rev_1",
      "objectId": "measure_sqty",
      "kind": "measure",
      "schemaVersion": 1,
      "name": "SQTY",
      "displayName": "Sales Quantity",
      "description": "Actual sales quantity at product-day across the same modeled location population as forecast.",
      "business": {
        "unit": "EA"
      },
      "definition": {
        "measureType": "referenced",
        "transactionId": "tx_sales",
        "valueColumnId": "sales_qty",
        "nativePlanningLevelId": "pl_pt",
        "resultType": {
          "type": "number",
          "nullable": true
        },
