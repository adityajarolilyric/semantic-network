{
  "name": "semantic-layer-configurator",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "setup:backend": "bash scripts/setup-backend.sh",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "docker compose -f backend/compose.dev.yml down",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"bash scripts/dev-api.sh\" \"npm run dev --prefix application\"",
    "dev:api": "bash scripts/dev-api.sh",
    "dev:application": "npm run dev --prefix application",
    "build": "npm run build --prefix application",
    "preview": "npm run preview --prefix application",
    "test:unit": "backend/.venv/bin/python -m pytest -c backend/pytest.ini backend/tests",
    "test:ui": "npm run test --prefix application",
    "test:integration": "backend/.venv/bin/python backend/scripts/test_csv_integration.py",
    "test:mongo": "backend/.venv/bin/python backend/scripts/test_integration.py",
    "test:e2e": "backend/.venv/bin/python backend/scripts/test_csv_integration.py --with-ui --ui-only",
    "setup:v1": "npm run setup",
    "db:up:v1": "npm run db:up",
    "dev:v1": "npm run dev",
    "dev:api:v1": "npm run dev:api",
    "dev:application:v1": "npm run dev:application",
    "build:v1": "npm run build",
    "test:ui:v1": "npm run test:ui",
    "test:backend:v1": "npm run test:unit",
    "start": "docker compose up --build -d --wait",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
