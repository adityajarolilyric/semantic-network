# Optional Compose overrides; docker compose up --build needs no .env file.
METADATA_WEB_PORT=5174
METADATA_API_PORT=8788
METADATA_MONGO_PORT=27018
METADATA_CLICKHOUSE_PORT=8123
METADATA_MONGO_DATABASE=semantic_metadata_v1
METADATA_CLICKHOUSE_DATABASE=semantic
METADATA_CLICKHOUSE_USERNAME=default
METADATA_CLICKHOUSE_PASSWORD=semantic
METADATA_ENVIRONMENT=development
# Set both for API key authentication; the UI proxy adds the key server-side.
# METADATA_ENVIRONMENT=production
# METADATA_API_KEY=replace-with-a-secret
# Preserve the existing installation's data volume identities.
METADATA_MONGO_VOLUME=backend_v1_metadata-mongo
METADATA_CLICKHOUSE_VOLUME=backend_v1_sources-clickhouse

# Query limits (not Docker Desktop VM allocation). Current measured workloads
# are query-analysis bound; increasing these does not remove repeated work.
METADATA_CLICKHOUSE_MAX_THREADS=4
METADATA_PLANNING_MAX_BYTES=2147483648
